[Unit]
Description=HomeLab Sentinel Core API
After=local-fs.target
ConditionPathExists=/opt/homelab-sentinel/app/api/server.py
ConditionPathExists=/srv/homelab-sentinel/sentinel/inventory.db

[Service]
Type=simple
User=homelab-sentinel
Group=homelab-sentinel
WorkingDirectory=/opt/homelab-sentinel/app
RuntimeDirectory=homelab-sentinel
RuntimeDirectoryMode=0755
ExecStart=/opt/homelab-sentinel/app/api/server.py --host 127.0.0.1 --port 8000 --database /srv/homelab-sentinel/sentinel/inventory.db
ExecStartPost=/opt/homelab-sentinel/app/scripts/wait-core-api.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
