[Unit]
Description=HomeLab Sentinel Monitoring Collection
After=local-fs.target network-online.target
Wants=network-online.target
ConditionPathExists=/opt/homelab-sentinel/app/scripts/with-inventory-lock.sh
ConditionPathExists=/opt/homelab-sentinel/app/core/monitoring/orchestrate.py
ConditionPathExists=/srv/homelab-sentinel/sentinel/inventory.db

[Service]
Type=oneshot
User=homelab-sentinel
Group=homelab-sentinel
WorkingDirectory=/opt/homelab-sentinel/app

ExecStart=/opt/homelab-sentinel/app/scripts/with-inventory-lock.sh /opt/homelab-sentinel/app/core/monitoring/orchestrate.py --database /srv/homelab-sentinel/sentinel/inventory.db --json
