#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT="/opt/homelab-sentinel/app"

usage() {
    cat <<'EOF_USAGE'
HomeLab Sentinel CLI

Usage:
  hls install
  hls status
  hls verify
  hls inventory [arguments...]
  hls help

Commands:
  install     Run the HomeLab Sentinel platform bootstrap
  status      Show Core service and API status
  verify      Run the complete Sentinel verification suite
  inventory   Query the Living Inventory
  help        Show this help
EOF_USAGE
}

require_file() {
    [[ -f "$1" ]] || {
        echo "[ERROR] Required Sentinel component not found: $1" >&2
        exit 1
    }
}

command_install() {
    if [[ "${EUID}" -ne 0 ]]; then
        echo "[ERROR] Installation requires root privileges." >&2
        echo "[SUGGESTION] Run: sudo hls install" >&2
        exit 1
    fi

    local installer="${APP_ROOT}/installer/install.sh"
    require_file "${installer}"

    exec "${installer}"
}

command_status() {
    echo "HomeLab Sentinel status"
    echo

    echo "Core API service:"
    systemctl is-enabled homelab-sentinel-api.service 2>/dev/null || true
    systemctl is-active homelab-sentinel-api.service 2>/dev/null || true

    echo
    echo "Post-boot verification service:"
    systemctl is-enabled homelab-sentinel-verify.service 2>/dev/null || true

    echo
    echo "Core API health:"
    if curl --fail --silent --max-time 5 \
        http://127.0.0.1:8000/api/v1/health; then
        echo
    else
        echo "[ERROR] Core API healthcheck failed." >&2
        return 1
    fi
}

command_verify() {
    local verifier="${APP_ROOT}/scripts/verify-sentinel.sh"
    require_file "${verifier}"

    exec "${verifier}"
}

command_inventory() {
    local inventory="${APP_ROOT}/core/inventory/inventory.py"
    require_file "${inventory}"

    exec "${inventory}" "$@"
}

main() {
    local command="${1:-help}"

    if (( $# > 0 )); then
        shift
    fi

    case "${command}" in
        install)
            command_install "$@"
            ;;
        status)
            command_status "$@"
            ;;
        verify)
            command_verify "$@"
            ;;
        inventory)
            command_inventory "$@"
            ;;
        help|-h|--help)
            usage
            ;;
        *)
            echo "[ERROR] Unknown command: ${command}" >&2
            echo
            usage >&2
            return 1
            ;;
    esac
}

main "$@"
